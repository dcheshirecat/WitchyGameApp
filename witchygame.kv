<MagicCard>:
    # Define the physical dimensions of the card
    size_hint: None, None
    size: 250, 350
    # Center the card in the middle of whatever layout holds it
    pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    # The actual graphic for the card
    Image:
        source: 'assets/card_back.png'
        allow_stretch: True
        keep_ratio: True
